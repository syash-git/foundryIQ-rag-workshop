# Configuration template for creating RAG agent with 
# Replace placeholders and set these variables in the process environment.
# This file is not loaded automatically; no additional dependencies are required.
# PowerShell example: $env:AZURE_SEARCH_ENDPOINT = "https://your-search-service.search.windows.net"
# Then run: python .\cerate-ks-blob-storage.py
# Authentication uses DefaultAzureCredential (for example, run az login first).
# Keep real storage connection strings private; do not commit them.

# Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account-name>/projects/<project-name>


# Names of the Foundry components being created
KNOWLEDGE_SOURCE_NAME=ks-it-desk-articles
KNOWLEDGE_BASE_NAME=kb-it-desk
FOUNDRY_PROJECT_CONNECTION_NAME=it-desk-knowledge-connection
FOUNDRY_AGENT_NAME=it-desk-agent

# Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME=it-desk

# Azure AI Search
AZURE_SEARCH_ENDPOINT=

# Azure OpenAI resource URL, shared by the chat and embedding deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_CHAT_MODEL=gpt-5.6-sol
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
